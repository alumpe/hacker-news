{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Keep runtime settings and bindings in sync with wrangler.jsonc. Omitting `main`
	// prevents generated application types from importing Cloudflare build output.
	"name": "hacker-news",
	"compatibility_date": "2026-09-19",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
